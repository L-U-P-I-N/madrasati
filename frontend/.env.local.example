NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SCHOOL_NAME=مدرستي

# وضع العرض التجريبي: true = بيانات ثابتة في المتصفح فقط، بلا خادم ولا قاعدة بيانات.
# مناسب لعرض المشروع على Vercel لعميل قبل ربط الخادم الحقيقي.
# لربط الخادم لاحقا: اجعلها false واضبط NEXT_PUBLIC_API_URL على رابط الـAPI الفعلي.
NEXT_PUBLIC_DEMO_MODE=false
